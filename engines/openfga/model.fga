model
  schema 1.1

# Reference TES AuthZ policy (tes-authzen/1 and /2) for OpenFGA, behind the shim.
# Source of truth for loading is model.json (same content, API format);
# keep both in sync (tests/test_openfga_model.py compares them via the fga CLI).

type user

# tes_task_set:<service>/own and tes_task_set:<service>/all
type tes_task_set
  relations
    define creator: [user:* with entitled]
    define image_ok: [user:* with images_allowed]
    define lister: [user:* with entitled]
    define CreateTask: creator and image_ok
    define ListTasks: lister
    define GetTask: [user]
    define CancelTask: [user]

# tes_service:<service>: every tes_task:<id> of that service, rewritten by the shim
type tes_service
  relations
    define owner: [user:* with is_owner]
    define member: [user:* with entitled]
    define admin: [user:* with entitled]
    define GetTask: (owner and member) or admin
    define CancelTask: (owner and member) or admin
    define CreateTask: [user]
    define ListTasks: [user]

condition entitled(subject_entitlements: list<string>, allowed_values: list<string>, allowed_prefixes: list<string>) {
  subject_entitlements.exists(e, e in allowed_values || allowed_prefixes.exists(p, e.startsWith(p)))
}

condition images_allowed(resource_images: list<string>, allowed_image_prefixes: list<string>) {
  size(allowed_image_prefixes) == 0 || resource_images.all(i, allowed_image_prefixes.exists(p, i.startsWith(p)))
}

condition is_owner(subject_id: string, resource_owner: string) {
  resource_owner != "" && resource_owner == subject_id
}
