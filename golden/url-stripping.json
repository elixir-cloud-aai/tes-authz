[
  {
    "input": "https://u:p@h/p?sig=x",
    "expected": "https://h/p",
    "description": "userinfo and query"
  },
  {
    "input": "s3://b/k?X-Amz-Signature=x",
    "expected": "s3://b/k",
    "description": "presigned query"
  },
  {
    "input": "drs://u:p@h/obj",
    "expected": "drs://h/obj",
    "description": "userinfo"
  },
  {
    "input": "ftp://a@b@h/p",
    "expected": "ftp://h/p",
    "description": "last '@' in the authority"
  },
  {
    "input": "https://h?sig=x",
    "expected": "https://h",
    "description": "query right after the host"
  },
  {
    "input": "https://h/p#frag",
    "expected": "https://h/p",
    "description": "fragment"
  },
  {
    "input": "s3://b/user@x/f",
    "expected": "s3://b/user@x/f",
    "description": "'@' in the path is kept"
  },
  {
    "input": "file:///d/f",
    "expected": "file:///d/f",
    "description": "empty authority"
  },
  {
    "input": "https://u:p?ss@h/p",
    "expected": null,
    "description": "step 2: '@' after '?' in the authority region"
  },
  {
    "input": "https://evil?x=@trusted/p",
    "expected": null,
    "description": "step 2: query with '@' before any '/'"
  },
  {
    "input": "u:p@host/x://y",
    "expected": null,
    "description": "no scheme before '://'; contains '@'"
  },
  {
    "input": "1s://u@h/p",
    "expected": null,
    "description": "invalid scheme; contains '@'"
  },
  {
    "input": "/local/path",
    "expected": "/local/path",
    "description": "no scheme, no '@' or '?'"
  },
  {
    "input": "/local/path?x",
    "expected": null,
    "description": "no scheme, contains '?'"
  },
  {
    "input": "user@host:path",
    "expected": null,
    "description": "no scheme, contains '@'"
  }
]
